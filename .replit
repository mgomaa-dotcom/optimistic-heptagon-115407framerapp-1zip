modules = ["python-base-3.13", "nodejs-24", "postgresql-16"]
[nix]
channel = "stable-25_05"
packages = ["postgresql", "unzip"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 server.py"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[objectStorage]
defaultBucketID = "replit-objstore-144e4ed6-28af-4673-a84b-9e265e957a44"

[deployment]
run = ["python3", "server.py"]
deploymentTarget = "cloudrun"
